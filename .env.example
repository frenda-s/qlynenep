# ── Auth ───────────────────────────────────────────────
# Secret ký session JWT. Sinh bằng: openssl rand -base64 32
AUTH_SECRET=dev-secret-change-me-in-production

# ── Database (libSQL / Turso) ─────────────────────────
# Local Node.js: để trống → dùng file:local.db (không cần token)
# Turso remote (bắt buộc khi deploy Cloudflare Workers):
#   LIBSQL_URL=libsql://<db-name>-<user>.turso.io
#   LIBSQL_AUTH_TOKEN=<turso-token>
LIBSQL_URL=
LIBSQL_AUTH_TOKEN=

# ── Cloudflare Deployment ──────────────────────────────
# Preset Nitro: cloudflare-module (mặc định cho CF Workers) hoặc node-server
NITRO_PRESET=cloudflare-module
