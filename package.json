{
  "name": "NeNepOS",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@11.3.0",
  "scripts": {
    "build": "nuxt build",
    "build:cf": "NITRO_PRESET=cloudflare-module nuxt build",
    "build:node": "NITRO_PRESET=node-server nuxt build",
    "build:mobile": "nuxt generate && node scripts/prepare-mobile.mjs && cap sync android",
    "dev": "nuxt dev",
    "preview:cf": "wrangler dev",
    "deploy:cf": "pnpm build:cf && wrangler deploy",
    "deploy": "pnpm build:cf && wrangler deploy",
    "start": "node .output/server/index.mjs",
    "preview": "node .output/server/index.mjs",
    "postinstall": "nuxt prepare",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node scripts/migrate.mjs",
    "db:sync-rules": "tsx scripts/sync-rules.ts",
    "db:seed": "tsx scripts/seed-run.ts",
    "db:reset": "tsx scripts/reset.ts",
    "test": "vitest run",
    "typecheck": "nuxt typecheck"
  },
  "dependencies": {
    "@capacitor/core": "^8.5.2",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/newsreader": "^5.3.0",
    "@libsql/client": "^0.18.0",
    "@lucide/vue": "^1.43.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "h3": "^1.15.11",
    "jose": "^6.2.12",
    "jsqr": "^1.4.0",
    "nuxt": "^4.5.2",
    "qrcode-generator": "^2.0.4",
    "reka-ui": "^2.10.4",
    "tailwind-merge": "^3.6.0",
    "vue": "^3.5.42",
    "vue-router": "^5.3.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/cli": "^8.5.2",
    "@tailwindcss/vite": "^4.3.3",
    "drizzle-kit": "^0.31.10",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "vitest": "^5.0.0",
    "vue-tsc": "^3.3.11",
    "wrangler": "^4.131.1"
  }
}
